# Telegram
BOT_TOKEN=
ADMIN_IDS=            # твой telegram id, через запятую если несколько

# Ключ шифрования сессий MAX. Любая длинная случайная строка.
# Потеряете — все подключённые аккаунты придётся заводить заново.
SECRET_KEY=

# Модель
LLM_PROVIDER=kimi     # kimi или gigachat
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
GIGACHAT_AUTH_KEY=    # необязательно, как запасной вариант

# Поведение
TIMEZONE=Europe/Moscow
DEFAULT_DIGEST_TIME=20:00
DEFAULT_MORNING_TIME=07:30   # утреннее напоминание о планах на день
DATA_DIR=data

# Внеочередная сводка, когда в чате внезапно прорвало.
# Пороги высокие намеренно: лишние сообщения раздражают сильнее,
# чем сводка, пришедшая вечером как обычно.
BURST_ENABLED=1
BURST_MIN_MESSAGES=25        # меньше — не всплеск, что бы ни говорила статистика
BURST_FACTOR=4               # во сколько раз час оживлённее обычного
BURST_COOLDOWN_HOURS=6       # сколько молчим после срабатывания
QUIET_HOURS=23-8             # ночью не тревожим
